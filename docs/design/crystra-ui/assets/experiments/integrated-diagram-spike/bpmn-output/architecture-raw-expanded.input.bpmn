<?xml version="1.0" encoding="UTF-8"?><bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions" targetNamespace="https://crystra.test/spike"><bpmn:process id="Process" isExecutable="false"><bpmn:subProcess id="explore" name="探索问题"><bpmn:task id="brainstorm" name="头脑风暴"><bpmn:incoming>edge-1</bpmn:incoming><bpmn:outgoing>edge-2</bpmn:outgoing></bpmn:task><bpmn:task id="scope" name="明确目标与约束"><bpmn:incoming>edge-2</bpmn:incoming><bpmn:outgoing>edge-3</bpmn:outgoing></bpmn:task><bpmn:sequenceFlow id="edge-2" sourceRef="brainstorm" targetRef="scope" name=""/><bpmn:sequenceFlow id="edge-3" sourceRef="scope" targetRef="options" name=""/></bpmn:subProcess><bpmn:subProcess id="architecture" name="形成架构方案"><bpmn:subProcess id="reviewing" name="多角度评审"><bpmn:parallelGateway id="fork" name="并行检查"><bpmn:incoming>edge-4</bpmn:incoming><bpmn:outgoing>edge-5</bpmn:outgoing><bpmn:outgoing>edge-6</bpmn:outgoing></bpmn:parallelGateway><bpmn:task id="quality" name="检查非功能需求"><bpmn:incoming>edge-5</bpmn:incoming><bpmn:outgoing>edge-7</bpmn:outgoing></bpmn:task><bpmn:task id="boundaries" name="检查职责与边界"><bpmn:incoming>edge-6</bpmn:incoming><bpmn:outgoing>edge-8</bpmn:outgoing></bpmn:task><bpmn:parallelGateway id="join" name="汇总评审"><bpmn:incoming>edge-7</bpmn:incoming><bpmn:incoming>edge-8</bpmn:incoming><bpmn:outgoing>edge-9</bpmn:outgoing></bpmn:parallelGateway><bpmn:sequenceFlow id="edge-5" sourceRef="fork" targetRef="quality" name=""/><bpmn:sequenceFlow id="edge-6" sourceRef="fork" targetRef="boundaries" name=""/><bpmn:sequenceFlow id="edge-7" sourceRef="quality" targetRef="join" name=""/><bpmn:sequenceFlow id="edge-8" sourceRef="boundaries" targetRef="join" name=""/><bpmn:sequenceFlow id="edge-9" sourceRef="join" targetRef="decision" name=""/></bpmn:subProcess><bpmn:task id="options" name="比较架构方案"><bpmn:incoming>edge-3</bpmn:incoming><bpmn:incoming>edge-11</bpmn:incoming><bpmn:outgoing>edge-4</bpmn:outgoing></bpmn:task><bpmn:exclusiveGateway id="decision" name="方案一致？"><bpmn:incoming>edge-9</bpmn:incoming><bpmn:outgoing>edge-10</bpmn:outgoing><bpmn:outgoing>edge-12</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:task id="adjust" name="调整方案"><bpmn:incoming>edge-10</bpmn:incoming><bpmn:outgoing>edge-11</bpmn:outgoing></bpmn:task><bpmn:sequenceFlow id="edge-4" sourceRef="options" targetRef="fork" name=""/><bpmn:sequenceFlow id="edge-10" sourceRef="decision" targetRef="adjust" name="有冲突"/><bpmn:sequenceFlow id="edge-11" sourceRef="adjust" targetRef="options" name=""/><bpmn:sequenceFlow id="edge-12" sourceRef="decision" targetRef="write" name="一致"/></bpmn:subProcess><bpmn:startEvent id="s" name="开始"><bpmn:outgoing>edge-1</bpmn:outgoing></bpmn:startEvent><bpmn:task id="write" name="按模板形成设计文档"><bpmn:incoming>edge-12</bpmn:incoming><bpmn:outgoing>edge-13</bpmn:outgoing></bpmn:task><bpmn:endEvent id="e" name="设计完成"><bpmn:incoming>edge-13</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="edge-1" sourceRef="s" targetRef="brainstorm" name=""/><bpmn:sequenceFlow id="edge-13" sourceRef="write" targetRef="e" name=""/></bpmn:process><bpmndi:BPMNDiagram id="Diagram"><bpmndi:BPMNPlane id="Plane" bpmnElement="Process"><bpmndi:BPMNShape id="di_explore" bpmnElement="explore" isExpanded="true"><dc:Bounds x="0" y="0" width="100" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="di_architecture" bpmnElement="architecture" isExpanded="true"><dc:Bounds x="0" y="0" width="100" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="di_reviewing" bpmnElement="reviewing" isExpanded="true"><dc:Bounds x="0" y="0" width="100" height="80"/></bpmndi:BPMNShape></bpmndi:BPMNPlane></bpmndi:BPMNDiagram></bpmn:definitions>