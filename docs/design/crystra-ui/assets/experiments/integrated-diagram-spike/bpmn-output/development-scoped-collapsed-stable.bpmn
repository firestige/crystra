      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="red_di" bpmnElement="red">
        <dc:Bounds x="175" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="green_di" bpmnElement="green">
        <dc:Bounds x="325" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="pass_di" bpmnElement="pass" isMarkerVisible="true">
        <dc:Bounds x="500" y="45" width="50" height="50" />
