      <bpmndi:BPMNShape id="BPMNShape_actions" bpmnElement="actions">
        <dc:Bounds x="366" y="240" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_join" bpmnElement="join" isMarkerVisible="true">
        <dc:Bounds x="566" y="95" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="575" y="76" width="32" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_complete" bpmnElement="complete" isMarkerVisible="true">
        <dc:Bounds x="716" y="95" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="722" y="76" width="39" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_supplement" bpmnElement="supplement">
        <dc:Bounds x="866" y="240" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="BPMNEdge_edge-2" bpmnElement="edge-2">
        <di:waypoint x="266" y="120" />
        <di:waypoint x="366" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_edge-4" bpmnElement="edge-4">
        <di:waypoint x="466" y="120" />
        <di:waypoint x="566" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_edge-6" bpmnElement="edge-6">
        <di:waypoint x="616" y="120" />
        <di:waypoint x="716" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_collect_entry_bridge" bpmnElement="collect_entry_bridge">
        <di:waypoint x="116" y="120" />
        <di:waypoint x="216" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_collect_exit_bridge" bpmnElement="collect_exit_bridge">
        <di:waypoint x="766" y="120" />
        <di:waypoint x="898" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_edge-3" bpmnElement="edge-3">
        <di:waypoint x="241" y="145" />
        <di:waypoint x="241" y="280" />
        <di:waypoint x="366" y="280" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_edge-7" bpmnElement="edge-7">
        <di:waypoint x="741" y="145" />
        <di:waypoint x="741" y="280" />
        <di:waypoint x="866" y="280" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="747" y="206" width="18" height="14" />
