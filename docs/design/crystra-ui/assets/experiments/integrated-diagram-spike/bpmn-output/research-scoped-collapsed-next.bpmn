          <dc:Bounds x="218" y="76" width="46" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_records" bpmnElement="records">
        <dc:Bounds x="366" y="80" width="100" height="80" />
