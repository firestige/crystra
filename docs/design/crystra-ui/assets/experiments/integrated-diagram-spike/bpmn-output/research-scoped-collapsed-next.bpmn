      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_edge-5" bpmnElement="edge-5">
        <di:waypoint x="466" y="280" />
        <di:waypoint x="591" y="280" />
        <di:waypoint x="591" y="145" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_edge-8" bpmnElement="edge-8">
        <di:waypoint x="916" y="320" />
        <di:waypoint x="916" y="340" />
        <di:waypoint x="241" y="340" />
        <di:waypoint x="241" y="145" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
  <bpmndi:BPMNDiagram id="BPMNDiagram_compute">
    <bpmndi:BPMNPlane id="BPMNPlane_compute" bpmnElement="compute">
      <bpmndi:BPMNShape id="BPMNShape_compute_start" bpmnElement="compute_start">
        <dc:Bounds x="80" y="102" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_compute_end" bpmnElement="compute_end">
        <dc:Bounds x="798" y="102" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_calc" bpmnElement="calc">
        <dc:Bounds x="216" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_check" bpmnElement="check">
        <dc:Bounds x="416" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_abnormal" bpmnElement="abnormal" isMarkerVisible="true">
        <dc:Bounds x="616" y="95" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="622" y="76" width="39" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_investigate" bpmnElement="investigate">
        <dc:Bounds x="766" y="240" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="BPMNEdge_edge-10" bpmnElement="edge-10">
        <di:waypoint x="316" y="120" />
        <di:waypoint x="416" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_edge-11" bpmnElement="edge-11">
        <di:waypoint x="516" y="120" />
        <di:waypoint x="616" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_compute_entry_bridge" bpmnElement="compute_entry_bridge">
        <di:waypoint x="116" y="120" />
        <di:waypoint x="216" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_compute_exit_bridge" bpmnElement="compute_exit_bridge">
        <di:waypoint x="666" y="120" />
        <di:waypoint x="798" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_edge-12" bpmnElement="edge-12">
