  <bpmndi:BPMNDiagram id="BPMNDiagram_tdd">
    <bpmndi:BPMNPlane id="BPMNPlane_tdd" bpmnElement="tdd">
      <bpmndi:BPMNShape id="BPMNShape_tdd_start" bpmnElement="tdd_start">
        <dc:Bounds x="80" y="102" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_tdd_end" bpmnElement="tdd_end">
        <dc:Bounds x="1116" y="102" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_red" bpmnElement="red">
        <dc:Bounds x="216" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_green" bpmnElement="green">
