<?xml version="1.0" encoding="UTF-8"?><bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions" targetNamespace="https://crystra.test/spike"><bpmn:process id="Process" isExecutable="false"><bpmn:subProcess id="collect" name="收集与核对"><bpmn:incoming>edge-1</bpmn:incoming><bpmn:outgoing>edge-9</bpmn:outgoing><bpmn:startEvent id="collect_start"><bpmn:outgoing>collect_entry_bridge</bpmn:outgoing></bpmn:startEvent><bpmn:endEvent id="collect_end"><bpmn:incoming>collect_exit_bridge</bpmn:incoming></bpmn:endEvent><bpmn:parallelGateway id="fork" name="收集两类材料"><bpmn:incoming>edge-8</bpmn:incoming><bpmn:incoming>collect_entry_bridge</bpmn:incoming><bpmn:outgoing>edge-2</bpmn:outgoing><bpmn:outgoing>edge-3</bpmn:outgoing></bpmn:parallelGateway><bpmn:task id="records" name="读取项目进展"><bpmn:incoming>edge-2</bpmn:incoming><bpmn:outgoing>edge-4</bpmn:outgoing></bpmn:task><bpmn:task id="actions" name="读取关键动作记录"><bpmn:incoming>edge-3</bpmn:incoming><bpmn:outgoing>edge-5</bpmn:outgoing></bpmn:task><bpmn:parallelGateway id="join" name="汇齐材料"><bpmn:incoming>edge-4</bpmn:incoming><bpmn:incoming>edge-5</bpmn:incoming><bpmn:outgoing>edge-6</bpmn:outgoing></bpmn:parallelGateway><bpmn:exclusiveGateway id="complete" name="材料完整？"><bpmn:incoming>edge-6</bpmn:incoming><bpmn:outgoing>edge-7</bpmn:outgoing><bpmn:outgoing>collect_exit_bridge</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:task id="supplement" name="请求补充材料"><bpmn:incoming>edge-7</bpmn:incoming><bpmn:outgoing>edge-8</bpmn:outgoing></bpmn:task><bpmn:sequenceFlow id="edge-2" sourceRef="fork" targetRef="records" name=""/><bpmn:sequenceFlow id="edge-3" sourceRef="fork" targetRef="actions" name=""/><bpmn:sequenceFlow id="edge-4" sourceRef="records" targetRef="join" name=""/><bpmn:sequenceFlow id="edge-5" sourceRef="actions" targetRef="join" name=""/><bpmn:sequenceFlow id="edge-6" sourceRef="join" targetRef="complete" name=""/><bpmn:sequenceFlow id="edge-7" sourceRef="complete" targetRef="supplement" name="缺失"/><bpmn:sequenceFlow id="edge-8" sourceRef="supplement" targetRef="fork" name=""/><bpmn:sequenceFlow id="collect_entry_bridge" sourceRef="collect_start" targetRef="fork" name=""/><bpmn:sequenceFlow id="collect_exit_bridge" sourceRef="complete" targetRef="collect_end" name=""/></bpmn:subProcess><bpmn:subProcess id="compute" name="计算与检查"><bpmn:incoming>edge-9</bpmn:incoming><bpmn:outgoing>edge-14</bpmn:outgoing><bpmn:startEvent id="compute_start"><bpmn:outgoing>compute_entry_bridge</bpmn:outgoing></bpmn:startEvent><bpmn:endEvent id="compute_end"><bpmn:incoming>compute_exit_bridge</bpmn:incoming></bpmn:endEvent><bpmn:task id="calc" name="计算进展指标"><bpmn:incoming>edge-13</bpmn:incoming><bpmn:incoming>compute_entry_bridge</bpmn:incoming><bpmn:outgoing>edge-10</bpmn:outgoing></bpmn:task><bpmn:task id="check" name="核对关键动作"><bpmn:incoming>edge-10</bpmn:incoming><bpmn:outgoing>edge-11</bpmn:outgoing></bpmn:task><bpmn:exclusiveGateway id="abnormal" name="存在异常？"><bpmn:incoming>edge-11</bpmn:incoming><bpmn:outgoing>edge-12</bpmn:outgoing><bpmn:outgoing>compute_exit_bridge</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:task id="investigate" name="核实并修正记录"><bpmn:incoming>edge-12</bpmn:incoming><bpmn:outgoing>edge-13</bpmn:outgoing></bpmn:task><bpmn:sequenceFlow id="edge-10" sourceRef="calc" targetRef="check" name=""/><bpmn:sequenceFlow id="edge-11" sourceRef="check" targetRef="abnormal" name=""/><bpmn:sequenceFlow id="edge-12" sourceRef="abnormal" targetRef="investigate" name="有"/><bpmn:sequenceFlow id="edge-13" sourceRef="investigate" targetRef="calc" name=""/><bpmn:sequenceFlow id="compute_entry_bridge" sourceRef="compute_start" targetRef="calc" name=""/><bpmn:sequenceFlow id="compute_exit_bridge" sourceRef="abnormal" targetRef="compute_end" name=""/></bpmn:subProcess><bpmn:startEvent id="s" name="本期开始"><bpmn:outgoing>edge-1</bpmn:outgoing></bpmn:startEvent><bpmn:task id="report" name="生成进展表格"><bpmn:incoming>edge-14</bpmn:incoming><bpmn:outgoing>edge-15</bpmn:outgoing></bpmn:task><bpmn:endEvent id="e" name="本期完成"><bpmn:incoming>edge-15</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="edge-1" sourceRef="s" targetRef="collect" name=""/><bpmn:sequenceFlow id="edge-9" sourceRef="collect" targetRef="compute" name="完整"/><bpmn:sequenceFlow id="edge-14" sourceRef="compute" targetRef="report" name="无"/><bpmn:sequenceFlow id="edge-15" sourceRef="report" targetRef="e" name=""/></bpmn:process><bpmndi:BPMNDiagram id="Diagram"><bpmndi:BPMNPlane id="Plane" bpmnElement="Process"><bpmndi:BPMNShape id="di_collect" bpmnElement="collect" isExpanded="false"><dc:Bounds x="0" y="0" width="100" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="di_compute" bpmnElement="compute" isExpanded="false"><dc:Bounds x="0" y="0" width="100" height="80"/></bpmndi:BPMNShape></bpmndi:BPMNPlane></bpmndi:BPMNDiagram></bpmn:definitions>