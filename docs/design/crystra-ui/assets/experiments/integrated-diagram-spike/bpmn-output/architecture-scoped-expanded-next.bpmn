      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="BPMNShape_architecture_start" bpmnElement="architecture_start">
        <dc:Bounds x="1008" y="262" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_architecture_end" bpmnElement="architecture_end">
